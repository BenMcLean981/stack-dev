{
  "name": "@stack-dev/core",
  "version": "0.2.1",
  "private": false,
  "license": "MIT",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "tsdown",
    "lint": "oxlint",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@stack-dev/oxfmt-config": "workspace:*",
    "@stack-dev/oxlint-config": "workspace:*",
    "@stack-dev/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
